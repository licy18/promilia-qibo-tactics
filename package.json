{
  "name": "promilia-qibo-tactics",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p electron/tsconfig.json --watch\" \"wait-on http://127.0.0.1:5174 dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5174 electron .\"",
    "electron:build": "tsc -p electron/tsconfig.json",
    "build": "tsc -b && vite build && npm run electron:build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "@types/node": "^24.10.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^42.0.0",
    "typescript": "^5.4.5",
    "vite": "^8.0.11",
    "wait-on": "^7.2.0"
  }
}
